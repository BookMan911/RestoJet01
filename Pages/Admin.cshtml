        }
        function deleteCustomer(guid) {
            if(confirm('@Model.LangService.Transilate("Are you sure?")')) {
                // Implement delete logic
            }
        }
        function editCustomer(guid) {
            // Implement edit logic
        }
        function deletePilot(guid) {
            if(confirm('@Model.LangService.Transilate("Are you sure?")')) {
                // Implement delete logic
            }
        }
        function editPilot(guid) {
            // Implement edit logic
        }
        function deleteOrder(guid) {
            if(confirm('@Model.LangService.Transilate("Are you sure?")')) {
                // Implement delete logic
            }
        }
        function editOrder(guid) {
            // Implement edit logic
        }
        
        function viewPilotOrders(pilotGuid, pilotName) {
            window.location.href = `/Pilot?pilot=${encodeURIComponent(pilotGuid)}&name=${encodeURIComponent(pilotName)}`;
        }
        
        let mealRowCount = 1;
        
        function addMealRow() {
            const container = document.getElementById('mealsContainer');
            const newRow = document.createElement('div');
            newRow.className = 'row mb-2 meal-row';
            newRow.innerHTML = `
                <div class="col-md-6">
                    <select class="form-select" name="orderItems[${mealRowCount}].MealGuid" required>
                        <option value="">@Model.LangService.Transilate("Select Meal")</option>
                        @foreach (var meal in Model.Meals)
                        {
                            <option value="@meal.Guid">@meal.Name - @meal.Price.ToString("C")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="orderItems[${mealRowCount}].Count" value="1" min="1" placeholder="@Model.LangService.Transilate("Count")" required />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeMealRow(this)">@Model.LangService.Transilate("Remove")</button>
                </div>
            `;
            container.appendChild(newRow);
            mealRowCount++;
        }
        
        function removeMealRow(button) {
            const row = button.closest('.meal-row');
            const container = document.getElementById('mealsContainer');
            if (container.querySelectorAll('.meal-row').length > 1) {
                row.remove();
            } else {
                alert('@Model.LangService.Transilate("At least one meal is required")');
            }
        }

        function uploadImage(input) {
            const file = input.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('image', file);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            fetch('/Admin?handler=UploadMealImage', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to upload image');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to upload image');
            });
        }

        function deleteImage(imageName) {
            if(!confirm('@Model.LangService.Transilate("Are you sure you want to delete this image?")')) {
                return;
            }

            // Create a form and submit it
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Admin?handler=DeleteMealImage';
            
            // Add antiforgery token
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                const hiddenToken = document.createElement('input');
                hiddenToken.type = 'hidden';
                hiddenToken.name = '__RequestVerificationToken';
                hiddenToken.value = tokenInput.value;
                form.appendChild(hiddenToken);
            }
            
            // Add image name parameter
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'imageName';
            hiddenInput.value = imageName;
            form.appendChild(hiddenInput);
            
            document.body.appendChild(form);
            form.submit();
        }

        let selectedMealGuid = null;

        function selectMealImage(mealGuid) {
            selectedMealGuid = mealGuid;
            // Switch to the meal images tab
            const tabTrigger = new bootstrap.Tab(document.querySelector('#meal-images-tab'));
            tabTrigger.show();
        }

        // Add click event listener to image cards in the meal images grid
        document.addEventListener('DOMContentLoaded', function() {
            const imageGrid = document.getElementById('imageGrid');
            if (imageGrid) {
                imageGrid.addEventListener('click', function(e) {
                    // Check if clicked on an image card (not the delete button)
                    const card = e.target.closest('.card');
                    const deleteBtn = e.target.closest('button[onclick^="deleteImage"]');
                    
                    if (card && !deleteBtn && selectedMealGuid) {
                        const img = card.querySelector('img');
                        if (img) {
                            // Extract just the filename from the src (e.g., "abc123.jpg" from "/meal-images/abc123.jpg")
                            const fullPath = img.src.split('/').pop();
                            // Get just the MD5 hash without extension
                            const imageHash = fullPath.split('.')[0];
                            assignImageToMeal(selectedMealGuid, imageHash);
                        }
                    }
                });
            }
        });

        function assignImageToMeal(mealGuid, imageHash) {
            fetch('/Admin?handler=AssignMealImage', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: new URLSearchParams({
                    mealGuid: mealGuid,
                    imageHash: imageHash
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('@Model.LangService.Transilate("Image assigned successfully!")');
                    selectedMealGuid = null;
                    location.reload();
                } else {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to assign image to meal');
            });
        }
    </script>
}
