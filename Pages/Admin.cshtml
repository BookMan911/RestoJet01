@page
@model RestoJett.Pages.AdminModel
@using System
@using System.Linq
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">@Model.LangService.Transilate("Admin Dashboard")</h1>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="meals-tab" data-bs-toggle="tab" data-bs-target="#meals" type="button" role="tab">@Model.LangService.Transilate("Meals")</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">@Model.LangService.Transilate("Users")</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="customers-tab" data-bs-toggle="tab" data-bs-target="#customers" type="button" role="tab">@Model.LangService.Transilate("Customers")</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pilots-tab" data-bs-toggle="tab" data-bs-target="#pilots" type="button" role="tab">@Model.LangService.Transilate("Pilots")</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab">@Model.LangService.Transilate("Orders")</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit" type="button" role="tab">@Model.LangService.Transilate("Audit Logs")</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="mealimages-tab" data-bs-toggle="tab" data-bs-target="#mealimages" type="button" role="tab">@Model.LangService.Transilate("Meal Images")</button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabsContent">
        <!-- Meals Tab -->
        <div class="tab-pane fade show active" id="meals" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.LangService.Transilate("Manage Meals")</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addMealModal">
                        <i class="bi bi-plus-circle"></i> @Model.LangService.Transilate("Add Meal")
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.MealError != null)
                    {
                        <div class="alert alert-danger">@Model.MealError.Message</div>
                    }
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Model.LangService.Transilate("Thumb")</th>
                                <th>@Model.LangService.Transilate("Name")</th>
                                <th>@Model.LangService.Transilate("Price")</th>
                                <th>@Model.LangService.Transilate("Discount")</th>
                                <th>@Model.LangService.Transilate("Version")</th>
                                <th>@Model.LangService.Transilate("Description")</th>
                                <th>@Model.LangService.Transilate("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meal in Model.Meals)
                            {
                                var thumbSrc = !string.IsNullOrEmpty(meal.ImageHash) ? $"/mealimages/{meal.ImageHash}" : "/mealimages/placeholder.png";
                                <tr data-meal-guid="@meal.Guid">
                                    <td>
                                        <img src="@thumbSrc" alt="@(meal.Name)" id="thumb-@meal.Guid" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                    </td>
                                    <td>@meal.Name</td>
                                    <td>@meal.Price.ToString("C")</td>
                                    <td>@meal.Discount.ToString("P")</td>
                                    <td>@meal.Version</td>
                                    <td>@meal.Description</td>
                                    <td>
                                        <button class="btn btn-sm btn-info me-1" onclick="selectImageForMeal('@meal.Guid')">@Model.LangService.Transilate("Select Image")</button>
                                        <button class="btn btn-sm btn-warning" onclick="editMeal('@meal.Guid')">@Model.LangService.Transilate("Edit")</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteMeal('@meal.Guid')">@Model.LangService.Transilate("Delete")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Users Tab -->
        <div class="tab-pane fade" id="users" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.LangService.Transilate("Manage Users")</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
                        <i class="bi bi-plus-circle"></i> @Model.LangService.Transilate("Add User")
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.UserError != null)
                    {
                        <div class="alert alert-danger">@Model.UserError.Message</div>
                    }
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Model.LangService.Transilate("Name")</th>
                                <th>@Model.LangService.Transilate("Type")</th>
                                <th>@Model.LangService.Transilate("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.Name</td>
                                    <td>@user.UserType</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick="editUser('@user.Guid')">@Model.LangService.Transilate("Edit")</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteUser('@user.Guid')">@Model.LangService.Transilate("Delete")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Customers Tab -->
        <div class="tab-pane fade" id="customers" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.LangService.Transilate("Manage Customers")</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
                        <i class="bi bi-plus-circle"></i> @Model.LangService.Transilate("Add Customer")
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.CustomerError != null)
                    {
                        <div class="alert alert-danger">@Model.CustomerError.Message</div>
                    }
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Model.LangService.Transilate("Name")</th>
                                <th>@Model.LangService.Transilate("Orders")</th>
                                <th>@Model.LangService.Transilate("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.Customers)
                            {
                                var customerOrders = Model.Orders.Where(o => o.CustomerGuid == customer.Guid).ToList();
                                var urlRes = !string.IsNullOrEmpty(customer.CurrentUrlRes) ? customer.CurrentUrlRes : "";
                                var customerLink = $"/Order?customerName={Uri.EscapeDataString(customer.Name)}&urlRes={Uri.EscapeDataString(urlRes)}";
                                <tr>
                                    <td><a href="@customerLink" class="text-decoration-none">@customer.Name</a></td>
                                    <td>
                                        @if (customerOrders.Any())
                                        {
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var order in customerOrders)
                                                {
                                                    <li><a href="/Order?order=@order.Guid" class="text-decoration-none">@order.Name</a></li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@Model.LangService.Transilate("No orders")</span>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="RenewCustomerUrlRes" class="d-inline" onsubmit="return confirm('@Model.LangService.Transilate("Are you sure you want to renew the URL for this customer?")');">
                                            <input type="hidden" name="customerGuid" value="@customer.Guid" />
                                            <button type="submit" class="btn btn-sm btn-info me-1">@Model.LangService.Transilate("New URL")</button>
                                        </form>
                                        <button class="btn btn-sm btn-warning me-1" onclick="editCustomer('@customer.Guid')">@Model.LangService.Transilate("Edit")</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteCustomer('@customer.Guid')">@Model.LangService.Transilate("Delete")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pilots Tab -->
        <div class="tab-pane fade" id="pilots" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.LangService.Transilate("Manage Pilots")</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addPilotModal">
                        <i class="bi bi-plus-circle"></i> @Model.LangService.Transilate("Add Pilot")
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.PilotError != null)
                    {
                        <div class="alert alert-danger">@Model.PilotError.Message</div>
                    }
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Model.LangService.Transilate("Name")</th>
                                <th>@Model.LangService.Transilate("Phone Number")</th>
                                <th>@Model.LangService.Transilate("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pilot in Model.Pilots)
                            {
                                var resUrl = !string.IsNullOrEmpty(pilot.CurrentResUrl) ? pilot.CurrentResUrl : "";
                                var pilotLink = $"/Pilot?name={Uri.EscapeDataString(pilot.Name)}&resUrl={Uri.EscapeDataString(resUrl)}";
                                <tr>
                                    <td>
                                        <a href="@pilotLink" class="text-decoration-none">
                                            @pilot.Name
                                        </a>
                                    </td>
                                    <td>@pilot.PhoneNumber</td>
                                    <td>
                                        <form method="post" asp-page-handler="RenewPilotResUrl" class="d-inline" onsubmit="return confirm('@Model.LangService.Transilate("Are you sure you want to renew the URL for this pilot?")');">
                                            <input type="hidden" name="pilotGuid" value="@pilot.Guid" />
                                            <button type="submit" class="btn btn-sm btn-info me-1">@Model.LangService.Transilate("New URL")</button>
                                        </form>
                                        <button class="btn btn-sm btn-warning me-1" onclick="editPilot('@pilot.Guid')">@Model.LangService.Transilate("Edit")</button>
                                        <button class="btn btn-sm btn-danger" onclick="deletePilot('@pilot.Guid')">@Model.LangService.Transilate("Delete")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Orders Tab -->
        <div class="tab-pane fade" id="orders" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.LangService.Transilate("Manage Orders")</h5>
                    <button class="btn btn-dark btn-sm" data-bs-toggle="modal" data-bs-target="#addOrderModal">
                        <i class="bi bi-plus-circle"></i> @Model.LangService.Transilate("Add Order")
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.OrderError != null)
                    {
                        <div class="alert alert-danger">@Model.OrderError.Message</div>
                    }
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Model.LangService.Transilate("Name")</th>
                                <th>@Model.LangService.Transilate("Customer")</th>
                                <th>@Model.LangService.Transilate("Pilot")</th>
                                <th>@Model.LangService.Transilate("Date")</th>
                                <th>@Model.LangService.Transilate("Order Status")</th>
                                <th>@Model.LangService.Transilate("Delivery Status")</th>
                                <th>@Model.LangService.Transilate("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                var pilot = Model.Pilots.FirstOrDefault(p => p.Guid == order.PilotGuid);
                                var pilotDisplayName = string.IsNullOrEmpty(order.PilotGuid) ? "-" : (pilot?.Name ?? order.PilotGuid);
                                <tr>
                                    <td>@order.Name</td>
                                    <td>@order.CustomerGuid</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.PilotGuid))
                                        {
                                            <a href="/Pilot?pilot=@order.PilotGuid&name=@Uri.EscapeDataString(pilotDisplayName)" class="text-decoration-none">
                                                @pilotDisplayName
                                            </a>
                                        }
                                        else
                                        {
                                            @:-
                                        }
                                    </td>
                                    <td>@order.Date</td>
                                    <td>@order.OrderStatus</td>
                                    <td>@order.DeliveryStatus</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" onclick="editOrder('@order.Guid')">@Model.LangService.Transilate("Edit")</button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteOrder('@order.Guid')">@Model.LangService.Transilate("Delete")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Audit Logs Tab -->
        <div class="tab-pane fade" id="audit" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">@Model.LangService.Transilate("Audit Logs")</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>@Model.LangService.Transilate("Timestamp")</th>
                                <th>@Model.LangService.Transilate("User")</th>
                                <th>@Model.LangService.Transilate("Action")</th>
                                <th>@Model.LangService.Transilate("Entity")</th>
                                <th>@Model.LangService.Transilate("Details")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.AuditLogs)
                            {
                                <tr>
                                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@log.UserName</td>
                                    <td>@log.ActionType</td>
                                    <td>@log.EntityType</td>
                                    <td>@log.Details</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Meal Images Tab -->
        <div class="tab-pane fade" id="mealimages" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Model.LangService.Transilate("Meal Images")</h5>
                    <form method="post" asp-page-handler="UploadMealImage" enctype="multipart/form-data" class="d-inline" asp-antiforgery="true">
                        <input type="file" name="imageFile" accept="image/*" class="form-control form-control-sm d-inline-block" style="width: auto;" required />
                        <button type="submit" class="btn btn-light btn-sm ms-2">@Model.LangService.Transilate("Upload Image")</button>
                    </form>
                </div>
                <div class="card-body">
                    @if (Model.ImageMessage != null)
                    {
                        <div class="alert alert-info">@Model.ImageMessage</div>
                    }
                    @if (Model.ImageError != null)
                    {
                        <div class="alert alert-danger">@Model.ImageError.Message</div>
                    }
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-3">
                        @foreach (var image in Model.MealImages)
                        {
                            var imageHash = System.IO.Path.GetFileNameWithoutExtension(image);
                            <div class="col" data-image-hash="@imageHash">
                                <div class="card h-100">
                                    <img src="@image" class="card-img-top" alt="Meal Image" style="height: 150px; object-fit: cover;" />
                                    <div class="card-body p-2 text-center">
                                        <small class="text-muted">@imageHash</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Meal Modal -->
<div class="modal fade" id="addMealModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddMeal" asp-antiforgery="true">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.LangService.Transilate("Add Meal")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Name")</label>
                        <input type="text" class="form-control" name="meal.Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Price")</label>
                        <input type="number" step="0.01" class="form-control" name="meal.Price" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Discount")</label>
                        <input type="number" step="0.01" class="form-control" name="meal.Discount" value="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Description")</label>
                        <textarea class="form-control" name="meal.Description"></textarea>
                    </div>
                    <input type="hidden" name="meal.Guid" value="" />
                    <input type="hidden" name="meal.ImageHash" value="" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Model.LangService.Transilate("Close")</button>
                    <button type="submit" class="btn btn-primary">@Model.LangService.Transilate("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Select Image Modal -->
<div class="modal fade" id="selectImageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Model.LangService.Transilate("Select Image")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="selectedMealGuid" />
                @if (Model.MealImages.Any())
                {
                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3" id="imageGrid">
                        @foreach (var image in Model.MealImages)
                        {
                            var imageHash = System.IO.Path.GetFileNameWithoutExtension(image);
                            <div class="col" data-image-hash="@imageHash">
                                <div class="card h-100" style="cursor: pointer;" onclick="chooseImage('@imageHash')">
                                    <img src="@image" class="card-img-top" alt="Meal Image" style="height: 100px; object-fit: cover;" />
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted">@Model.LangService.Transilate("No images uploaded yet. Please upload images in the Meal Images tab.")</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Model.LangService.Transilate("Cancel")</button>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddUser" asp-antiforgery="true">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.LangService.Transilate("Add User")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Name")</label>
                        <input type="text" class="form-control" name="user.Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Password")</label>
                        <input type="password" class="form-control" name="user.Password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("User Type")</label>
                        <select class="form-select" name="user.UserType">
                            <option value="Admin">Admin</option>
                            <option value="Staff">Staff</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Model.LangService.Transilate("Close")</button>
                    <button type="submit" class="btn btn-success">@Model.LangService.Transilate("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Customer Modal -->
<div class="modal fade" id="addCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddCustomer" asp-antiforgery="true">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.LangService.Transilate("Add Customer")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Name")</label>
                        <input type="text" class="form-control" name="customer.Name" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Model.LangService.Transilate("Close")</button>
                    <button type="submit" class="btn btn-info">@Model.LangService.Transilate("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Pilot Modal -->
<div class="modal fade" id="addPilotModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddPilot" asp-antiforgery="true">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.LangService.Transilate("Add Pilot")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Name")</label>
                        <input type="text" class="form-control" name="pilot.Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Phone Number")</label>
                        <input type="text" class="form-control" name="pilot.PhoneNumber" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Model.LangService.Transilate("Close")</button>
                    <button type="submit" class="btn btn-info">@Model.LangService.Transilate("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Order Modal -->
<div class="modal fade" id="addOrderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddOrder" asp-antiforgery="true">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.LangService.Transilate("Add Order")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Customer")</label>
                        <select class="form-select" name="order.CustomerGuid" required>
                            @foreach (var customer in Model.Customers)
                            {
                                <option value="@customer.Guid">@customer.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Pilot")</label>
                        <select class="form-select" name="order.PilotGuid">
                            <option value="">@Model.LangService.Transilate("Select Pilot")</option>
                            @foreach (var pilot in Model.Pilots)
                            {
                                <option value="@pilot.Guid">@pilot.Name - @pilot.PhoneNumber</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Meals")</label>
                        <div id="mealsContainer">
                            <div class="row mb-2 meal-row">
                                <div class="col-md-6">
                                    <select class="form-select" name="orderItems[0].MealGuid" required>
                                        <option value="">@Model.LangService.Transilate("Select Meal")</option>
                                        @foreach (var meal in Model.Meals)
                                        {
                                            <option value="@meal.Guid">@meal.Name - @meal.Price.ToString("C")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <input type="number" class="form-control" name="orderItems[0].Count" value="1" min="1" placeholder="@Model.LangService.Transilate("Count")" required />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-danger btn-sm" onclick="removeMealRow(this)">@Model.LangService.Transilate("Remove")</button>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-secondary mt-2" onclick="addMealRow()">@Model.LangService.Transilate("Add Meal")</button>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Model.LangService.Transilate("Payment Type")</label>
                        <select class="form-select" name="order.PaymentType" required>
                            <option value="">@Model.LangService.Transilate("Select Payment Type")</option>
                            <option value="None">@Model.LangService.Transilate("None")</option>
                            <option value="ByPilot">@Model.LangService.Transilate("By Pilot")</option>
                            <option value="Online">@Model.LangService.Transilate("Online")</option>
                            <option value="Cash">@Model.LangService.Transilate("Cash")</option>
                            <option value="Dept">@Model.LangService.Transilate("Dept")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Model.LangService.Transilate("Close")</button>
                    <button type="submit" class="btn btn-warning">@Model.LangService.Transilate("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

