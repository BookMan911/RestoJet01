        function viewPilotOrders(pilotGuid, pilotName) {
            window.location.href = `/Pilot?pilot=${encodeURIComponent(pilotGuid)}&name=${encodeURIComponent(pilotName)}`;
        }
        
        let mealRowCount = 1;
        
        function addMealRow() {
            const container = document.getElementById('mealsContainer');
            const newRow = document.createElement('div');
            newRow.className = 'row mb-2 meal-row';
            newRow.innerHTML = `
                <div class="col-md-6">
                    <select class="form-select" name="orderItems[${mealRowCount}].MealGuid" required>
                        <option value="">@Model.LangService.Transilate("Select Meal")</option>
                        @foreach (var meal in Model.Meals)
                        {
                            <option value="@meal.Guid">@meal.Name - @meal.Price.ToString("C")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="orderItems[${mealRowCount}].Count" value="1" min="1" placeholder="@Model.LangService.Transilate("Count")" required />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeMealRow(this)">@Model.LangService.Transilate("Remove")</button>
                </div>
            `;
            container.appendChild(newRow);
            mealRowCount++;
        }
        
        function removeMealRow(button) {
            const row = button.closest('.meal-row');
            const container = document.getElementById('mealsContainer');
            if (container.querySelectorAll('.meal-row').length > 1) {
                row.remove();
            } else {
                alert('@Model.LangService.Transilate("At least one meal is required")');
            }
        }

        let currentSelectedMealGuid = null;

        function selectImageForMeal(mealGuid) {
            currentSelectedMealGuid = mealGuid;
            document.getElementById('selectedMealGuid').value = mealGuid;
            var selectImageModal = new bootstrap.Modal(document.getElementById('selectImageModal'));
            selectImageModal.show();
        }

        function chooseImage(imageHash) {
            if (currentSelectedMealGuid) {
                console.log('Updating meal:', currentSelectedMealGuid, 'with image:', imageHash);
                
                // Get the antiforgery token from the main form on the page
                var token = document.querySelector('form[asp-antiforgery="true"] input[name="__RequestVerificationToken"], form[method="post"] input[name="__RequestVerificationToken"]');
                if (!token) {
                    // Try to find any hidden input with the token name
                    token = document.querySelector('input[name="__RequestVerificationToken"][type="hidden"]');
                }
                
                if (!token || !token.value) {
                    console.error('Antiforgery token not found');
                    alert('@Model.LangService.Transilate("Error: Could not find security token")');
                    return;
                }
                
                console.log('Found token, sending request...');
                
                fetch('/Admin?handler=UpdateMealImage', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token.value,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ mealGuid: currentSelectedMealGuid, imageHash: imageHash })
                })
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error('Server returned ' + response.status);
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('Server response:', result);
                    if (result.success) {
                        // Update the thumbnail immediately without reload
                        var img = document.getElementById('thumb-' + currentSelectedMealGuid);
                        if (img) {
                            img.src = '/mealimages/' + result.imageHash + '?t=' + new Date().getTime();
                            img.alt = 'Updated image';
                            console.log('Image updated successfully:', img.src);
                        } else {
                            console.error('Could not find image element with id: thumb-' + currentSelectedMealGuid);
                        }
                        
                        // Close modal
                        var selectImageModal = bootstrap.Modal.getInstance(document.getElementById('selectImageModal'));
                        selectImageModal.hide();
                    } else {
                        console.error('Update failed:', result.error);
                        alert('@Model.LangService.Transilate("Failed to update meal image: ")' + (result.error || 'Unknown error'));
                    }
                })
                .catch(error => {
                    console.error('Fetch error:', error);
                    alert('@Model.LangService.Transilate("Failed to update meal image. Check console for details.")');
                });
            }
        }
    </script>
}
