            }
        }
        function editCustomer(guid) {
            // Implement edit logic
        }
        function deletePilot(guid) {
            if(confirm('@Model.LangService.Transilate("Are you sure?")')) {
                // Implement delete logic
            }
        }
        function editPilot(guid) {
            // Implement edit logic
        }
        function deleteOrder(guid) {
            if(confirm('@Model.LangService.Transilate("Are you sure?")')) {
                // Implement delete logic
            }
        }
        function editOrder(guid) {
            // Implement edit logic
        }
        
        function viewPilotOrders(pilotGuid, pilotName) {
            window.location.href = `/Pilot?pilot=${encodeURIComponent(pilotGuid)}&name=${encodeURIComponent(pilotName)}`;
        }
        
        let mealRowCount = 1;
        
        function addMealRow() {
            const container = document.getElementById('mealsContainer');
            const newRow = document.createElement('div');
            newRow.className = 'row mb-2 meal-row';
            newRow.innerHTML = `
                <div class="col-md-6">
                    <select class="form-select" name="orderItems[${mealRowCount}].MealGuid" required>
                        <option value="">@Model.LangService.Transilate("Select Meal")</option>
                        @foreach (var meal in Model.Meals)
                        {
                            <option value="@meal.Guid">@meal.Name - @meal.Price.ToString("C")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="number" class="form-control" name="orderItems[${mealRowCount}].Count" value="1" min="1" placeholder="@Model.LangService.Transilate("Count")" required />
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeMealRow(this)">@Model.LangService.Transilate("Remove")</button>
                </div>
            `;
            container.appendChild(newRow);
            mealRowCount++;
        }
        
        function removeMealRow(button) {
            const row = button.closest('.meal-row');
            const container = document.getElementById('mealsContainer');
            if (container.querySelectorAll('.meal-row').length > 1) {
                row.remove();
            } else {
                alert('@Model.LangService.Transilate("At least one meal is required")');
            }
        }
    </script>
}
